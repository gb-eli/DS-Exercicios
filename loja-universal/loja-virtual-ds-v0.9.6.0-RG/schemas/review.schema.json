{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loja-virtual-ds.local/schemas/review.schema.json",
  "title": "DS Store Review v0.8.0",
  "type": "object",
  "required": ["reviewId", "transactionId", "direction", "amount", "status", "createdAt"],
  "properties": {
    "reviewId": {"type": "string"},
    "transactionId": {"type": "string"},
    "type": {"type": "string"},
    "direction": {"enum": ["CREDIT", "DEBIT"]},
    "amount": {"type": "integer", "minimum": 0},
    "level": {"type": "string"},
    "targetSeconds": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "checkpointValues": {"type": "array", "items": {"type": "integer"}},
    "teacherRequired": {"type": "boolean"},
    "status": {"enum": ["PENDING", "APPROVED", "BLOCKED", "DISMISSED"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "resolvedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
