{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds.local/schemas/item.schema.json",
  "title": "Item da Loja Virtual DS",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "rarity",
    "basePrice",
    "slot",
    "pack"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string"
    },
    "rarity": {
      "enum": [
        "basic",
        "rare",
        "epic",
        "legendary",
        "mythic",
        "relic"
      ]
    },
    "basePrice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000
    },
    "slot": {
      "type": "string"
    },
    "pack": {
      "type": "string"
    },
    "previewType": {
      "enum": [
        "animation",
        "avatar",
        "item360",
        "vfx"
      ]
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": true
}