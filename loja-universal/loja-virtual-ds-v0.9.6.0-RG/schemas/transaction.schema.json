{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loja-virtual-ds.local/schemas/transaction.schema.json",
  "title": "DS Store Transaction v0.8.0",
  "type": "object",
  "required": ["transactionId", "profileId", "type", "status", "amount", "createdAt", "previousHash", "payloadHash"],
  "properties": {
    "transactionId": {"type": "string", "minLength": 4},
    "profileId": {"type": "string"},
    "platformId": {"type": "string"},
    "type": {"type": "string"},
    "status": {"enum": ["AUTHORIZED", "UNDER_REVIEW", "PENDING", "BLOCKED", "DENIED", "REVERSED", "CANCELLED"]},
    "amount": {"type": "integer"},
    "balanceBefore": {"type": "integer"},
    "balanceAfter": {"type": "integer"},
    "originEventId": {"type": ["string", "null"]},
    "evidenceId": {"type": ["string", "null"]},
    "activityId": {"type": ["string", "null"]},
    "itemId": {"type": ["string", "null"]},
    "reviewLevel": {"type": ["string", "null"]},
    "validationTargetSeconds": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "createdAt": {"type": "string", "format": "date-time"},
    "previousHash": {"type": ["string", "null"]},
    "payloadHash": {"type": "string"}
  },
  "additionalProperties": true
}
