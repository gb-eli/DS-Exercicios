{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds.local/schemas/reward-event.schema.json",
  "title": "Evento de recompensa DS",
  "type": "object",
  "required": [
    "eventId",
    "profileId",
    "type",
    "amount",
    "platformId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 6
    },
    "profileId": {
      "type": "string",
      "minLength": 3
    },
    "type": {
      "enum": [
        "TUTORIAL_COMPLETED",
        "TOOL_RESULT_CREATED",
        "LAB_COMPLETED",
        "PHASE_COMPLETED",
        "MISSION_COMPLETED",
        "CHALLENGE_COMPLETED",
        "PROJECT_PUBLISHED",
        "EVIDENCE_EXPORTED",
        "ACHIEVEMENT_UNLOCKED",
        "TEACHER_REWARD",
        "SESSION_COMPLETED",
        "COLLABORATION_VALIDATED",
        "FEEDBACK_CONFIRMED",
        "BUG_REPORT_CONFIRMED",
        "LEARNING_PROGRESS",
        "RECOVERY_COMPLETED"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500000
    },
    "platformId": {
      "enum": [
        "desafio-ds",
        "lab-virtual-ds",
        "ctf-ds",
        "modo-guiado-ds",
        "diagnostico-edu",
        "lab-ds-3d-vr",
        "game-informatica",
        "rcp-adapta",
        "central-ds",
        "professor-admin"
      ]
    },
    "evidenceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
