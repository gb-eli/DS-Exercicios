{
  "version": "0.9.6.0-RG",
  "schemaVersion": 1,
  "storage": {
    "keyPrefix": "ds-backpack-v1",
    "snapshotKeyPrefix": "ds-profile-persistence-v1",
    "checkpointCount": 3,
    "indexedDB": "ds-profile-v1",
    "store": "snapshots",
    "autoSaveDelayMs": 420
  },
  "capacity": {
    "items": 8,
    "quickAnimations": 6,
    "quickMessages": 6
  },
  "groups": {
    "wearable": {
      "label": "Visual e equipamentos",
      "limit": 4,
      "categories": [
        "appearance",
        "clothing",
        "headwear",
        "accessory",
        "vehicle",
        "companion"
      ]
    },
    "tool": {
      "label": "Ferramentas",
      "limit": 2,
      "categories": [
        "tool"
      ]
    },
    "effect": {
      "label": "Auras e efeitos",
      "limit": 2,
      "categories": [
        "aura"
      ]
    }
  },
  "animationMap": {
    "emote-wave": "Wave",
    "emote-goodbye": "Goodbye",
    "emote-think": "Think",
    "emote-point": "Point",
    "emote-sit": "Sit",
    "emote-jump": "Jump",
    "emote-applause": "Applause",
    "emote-celebrate": "Celebrate"
  },
  "defaultAnimations": [
    "Wave",
    "Jump",
    "DanceLoop",
    "VictoryPose",
    "WalkShowcase",
    "ThumbsUp"
  ],
  "defaultMessages": [
    "Olá!",
    "Bom dia!",
    "Vamos estudar!",
    "Vamos programar!",
    "Vamos fazer um desafio!",
    "Meu nome é Estudante DS."
  ],
  "protectedDomains": [
    "wallet",
    "ledger",
    "integrity",
    "transactionHistory"
  ],
  "notes": [
    "A mochila salva apenas IDs e atalhos.",
    "GLBs, texturas e VFX permanecem no cache modular.",
    "Dados financeiros não podem ser importados por backup de personalização."
  ]
}