insert into public.reward_rules(platform_id,activity_id,event_type,trust_level,xp,points,coins,repeatable,active,metadata) values(p,'tool:cmd','tool.first_validated','server_verified',0,0,15,false,true,'{"source":"lab-virtual"}'::jsonb);
