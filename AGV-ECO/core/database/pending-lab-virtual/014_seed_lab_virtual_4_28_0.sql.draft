-- LAB Virtual DS 4.28.0 — catálogo P1
do $$ declare p uuid; begin
select id into p from public.platforms where code='lab-virtual';
if p is null then raise exception 'platform lab-virtual missing'; end if;
insert into public.activity_catalog(platform_id,activity_id,name,reward_policy,max_xp,max_points,max_coins,repeatable,active,metadata) values(p,'tool:cmd','Prompt de Comando — CMD','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"cmd","level":"basic","module":"","type":"terminal","firstValidationBonus":15}'::jsonb) on conflict(platform_id,activity_id) do update set name=excluded.name,metadata=excluded.metadata,active=true;
