    {
      "id": "challenge-start",
      "label": "Iniciar Desafio DS",
      "risk": "LOW",
      "preferredMode": "CLASS_SHARED_PIN",
      "pinLength": 8,
      "ttlSeconds": 900,
      "singleUse": false,
      "requireReason": false
    },
    {
      "id": "assessment-start",
      "label": "Iniciar Modo Prova",
      "risk": "MEDIUM",
      "preferredMode": "SESSION_SCOPED_PIN",
      "pinLength": 8,
      "ttlSeconds": 300,
      "singleUse": true,
      "requireReason": false
    },
    {
      "id": "lesson-start",
      "label": "Iniciar aula guiada",
      "risk": "LOW",
      "preferredMode": "CLASS_SHARED_PIN",
      "pinLength": 8,
      "ttlSeconds": 900,
      "singleUse": false,
      "requireReason": false
    },
    {
      "id": "early-completion",
      "label": "Autorizar conclusão antecipada",
      "risk": "HIGH",
      "preferredMode": "SESSION_SCOPED_PIN",
      "pinLength": 10,
      "ttlSeconds": 180,
      "singleUse": true,
      "requireReason": true
    },
    {
      "id": "prova-rescue",
      "label": "Liberar continuação da prova",
      "risk": "HIGH",
      "preferredMode": "SESSION_SCOPED_PIN",
      "pinLength": 10,
      "ttlSeconds": 180,
      "singleUse": true,
      "requireReason": true
    },
    {
      "id": "teacher-audit",
      "label": "Abrir auditoria docente",
      "risk": "CRITICAL",
      "preferredMode": "SIGNED_GRANT",
      "pinLength": 0,
      "ttlSeconds": 120,
      "singleUse": true,
      "requireReason": true
    },
    {
      "id": "profile-recovery",
      "label": "Abrir recuperação de perfil",
      "risk": "CRITICAL",
      "preferredMode": "SIGNED_GRANT",
      "pinLength": 0,
      "ttlSeconds": 120,
      "singleUse": true,
      "requireReason": true
    },
    {
      "id": "profile-recovery-reset",
      "label": "Redefinir senha do perfil",
      "risk": "CRITICAL",
      "preferredMode": "SIGNED_GRANT",
      "pinLength": 0,
      "ttlSeconds": 120,
      "singleUse": true,
      "requireReason": true
    }
