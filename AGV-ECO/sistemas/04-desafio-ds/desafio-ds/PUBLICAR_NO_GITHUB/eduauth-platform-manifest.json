      "source": "runtime",
      "path": "modo ou disciplina"
    },
    "lessonId": {
      "source": "runtime",
      "path": "modo/aula"
    },
    "activityId": {
      "source": "runtime",
      "path": "ação atual"
    },
    "profileIdHash": {
      "source": "runtime-optional",
      "path": "perfil local"
    },
    "sessionId": {
      "source": "generated",
      "storage": "sessionStorage"
    }
