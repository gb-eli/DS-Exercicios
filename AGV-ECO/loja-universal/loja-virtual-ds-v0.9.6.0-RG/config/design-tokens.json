  "graphicsModes": [
    "basic",
    "intermediate",
    "advanced",
    "ultra",
    "realism"
  ],
  "sceneTokens": {
    "basic": "essential",
    "intermediate": "balanced-neon",
    "advanced": "tech-studio",
    "ultra": "holographic-premium",
    "realism": "cinematic-realism"
  }
}
