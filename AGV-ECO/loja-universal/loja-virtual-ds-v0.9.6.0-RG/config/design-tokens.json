{
  "version": "0.9.5",
  "name": "Loja Virtual DS Design System",
  "theme": "dark-neon-educational",
  "colors": {
    "background": "#050914",
    "panel": "#0b1424",
    "text": "#eef8ff",
    "muted": "#8ea7c0",
    "cyan": "#2ad7ff",
    "violet": "#9a67ff",
    "pink": "#ff4fb8",
    "gold": "#ffbd32",
    "green": "#48e4a6",
    "red": "#ff5e78"
  },
  "radii": {
    "xl": 28,
    "lg": 22,
    "md": 16,
    "sm": 12
  },
  "breakpoints": {
    "mobile": 560,
    "tablet": 820,
    "compactDesktop": 1050,
    "desktop": 1280
  },
  "navigation": {
