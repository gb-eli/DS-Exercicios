{
  "schema": "eduauth-platform-manifest",
  "schemaVersion": 1,
  "protocolVersion": 1,
  "platform": {
    "id": "desafio-informatica-agv",
    "name": "Desafio de Informática AGV",
    "version": "2.5.0",
    "repository": "",
    "origin": ""
  },
  "integration": {
    "status": "structural-complete-development",
    "coreVersion": "1.0.0",
    "offlineSupported": true,
    "githubPagesSupported": true,
    "productionProvisioned": false
  },
  "requestCode": {
    "prefix": "EA1",
    "encoding": "BASE32_CROCKFORD",
    "checksum": "CRC32C-20",
    "caseInsensitive": true,
    "ignoreSeparators": true,
    "classCompactLength": 30,
    "sessionCompactLength": 56,
    "sessionIssuedAtQuantumSeconds": 5
  },
  "identifierRegistry": {
    "platformCode": "01",
    "classes": {
      "01": "1adm",
      "02": "2adm"
    },
    "subjects": {
      "01": "informatica-empresarial"
    },
    "lessons": {
      "00": "platform-general",
      "01": "1adm-01",
      "02": "1adm-02",
      "03": "1adm-03",
      "04": "1adm-04",
      "05": "1adm-05",
      "06": "1adm-06",
      "07": "1adm-07",
      "08": "2adm-01",
      "09": "2adm-02",
      "10": "2adm-03",
      "11": "diagnostico",
      "12": "1adm-08",
      "13": "1adm-09",
      "14": "2adm-04",
      "15": "2adm-05"
    },
    "activities": {
      "01": "guided-lesson",
      "02": "diagnostic-general",
      "03": "diagnostic-class",
      "04": "profile",
      "05": "class-release"
    },
    "actions": {
      "01": "lesson-start",
      "02": "result-release",
      "03": "early-completion",
      "04": "profile-recovery"
    }
  },
  "keyConfiguration": {
    "classKeyId": "desafio-informatica-agv-class-01",
    "sessionKeyId": "desafio-informatica-agv-session-01",
    "signingPublicKeyId": "teacher-signing-test-01",
    "recoveryPublicKeyId": "teacher-recovery-test-01",
    "environment": "development"
  },
  "timePolicy": {
    "useUtc": true,
    "fixedLessonTimeSlot": 0,
    "classReleaseWindowSeconds": 3600,
    "sessionWindowSeconds": 300,
    "highRiskWindowSeconds": 180,
    "maximumAttempts": 5
  },
  "contextSources": {
    "classId": {
      "source": "runtime",
      "path": "profile.classId"
    },
    "subjectId": {
      "source": "static",
      "path": "PLATFORM.subjectId"
    },
    "lessonId": {
      "source": "runtime",
      "path": "lesson.id | diagnostico | platform-general"
    },
    "activityId": {
      "source": "runtime",
      "path": "guided-lesson | diagnostic-general | diagnostic-class | profile"
    },
    "profileIdHash": {
      "source": "runtime-optional",
      "path": "profile.id -> SHA-256 truncado"
    },
    "sessionId": {
      "source": "generated",
      "storage": "sessionStorage"
    }
  },
  "actions": [
    "lesson-start",
    "result-release",
    "early-completion",
    "profile-recovery"
  ],
  "storage": {
    "sessionStore": "sessionStorage",
    "authorizationStore": "sessionStorage",
    "auditStore": "IndexedDB"
  },
  "security": {
    "maximumAttempts": 5,
    "progressiveDelay": true,
    "staticPasswordPresent": false,
    "staticMasterPasswordPresent": false,
    "privateKeyPresent": false,
    "profileEnvelope": "AES-GCM data key + password envelope + RSA-OAEP recovery envelope"
  },
  "ui": {
    "publicRequestCode": true,
    "copyButton": true,
    "manualEntry": true,
    "qrOptional": true,
    "cameraRequired": false,
    "reducedMotion": true,
    "keyboardAccessible": true
  },
  "compatibility": {
    "chromeAndroid": "not-tested-in-this-environment",
    "chromeChromebook": "not-tested-in-this-environment",
    "edgeWindows": "not-tested-in-this-environment",
    "offline": "static-cache-and-code-path-tested"
  },
  "limitations": [
    "As chaves simétricas de desenvolvimento estão publicadas no frontend e podem ser extraídas por usuário avançado.",
    "A integração ainda não recebeu chaves de produção do EduAuth Professor.",
    "Logs são locais e não constituem auditoria central ou inviolável.",
    "A redefinição completa da senha do perfil depende do validador com a chave privada de recuperação.",
    "A execução visual em navegador automatizado foi bloqueada pela política administrativa do ambiente de testes."
  ],
  "pendingItems": [
    "Construir ou provisionar o EduAuth Professor e substituir as chaves de desenvolvimento.",
    "Configurar repositório e origem de publicação.",
    "Concluir o token de retorno da recuperação e a tela de definição da nova senha.",
    "Executar testes manuais em Chrome Android, Chromebook e Edge Windows."
  ],
  "authorizationPolicy": {
    "lessonStart": "fixed-per-lesson",
    "resultRelease": "class-shared-current-hour",
    "earlyCompletion": "class-shared-current-hour",
    "profileRecovery": "session-scoped"
  }
}
