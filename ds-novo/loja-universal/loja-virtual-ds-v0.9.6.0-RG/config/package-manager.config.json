{
  "version": "0.9.6.0-RG",
  "database": "ds-store-package-manager",
  "store": "packageState",
  "cachePrefix": "ds-store-pack",
  "defaultPriority": "balanced",
  "allowAutoDowngrade": true,
  "maxConcurrentDownloads": 3,
  "verifySha256": true,
  "storageWarningThreshold": 0.82,
  "persistentStorageRecommended": true,
  "cleanupPolicy": "lru",
  "qualityModeMapping": {
    "basic": [
      "graphics-essential"
    ],
    "intermediate": [
      "graphics-essential",
      "graphics-balanced"
    ],
    "advanced": [
      "graphics-essential",
      "graphics-balanced",
      "graphics-high-core",
      "module-equipment-3d"
    ],
    "ultra": [
      "graphics-essential",
      "graphics-balanced",
      "graphics-high-core",
      "graphics-ultra-core",
      "module-equipment-3d",
      "module-vfx-ultra"
    ],
    "realism": [
      "graphics-essential",
      "graphics-balanced",
      "graphics-high-core",
      "graphics-ultra-core",
      "graphics-cinematic",
      "module-equipment-3d",
      "module-vfx-ultra"
    ],
    "economy": [
      "graphics-essential"
    ],
    "balanced": [
      "graphics-essential",
      "graphics-balanced"
    ],
    "high": [
      "graphics-essential",
      "graphics-balanced",
      "graphics-high-core",
      "module-equipment-3d"
    ],
    "ultraAdvanced": [
      "graphics-essential",
      "graphics-balanced",
      "graphics-high-core",
      "graphics-ultra-core",
      "graphics-cinematic",
      "module-equipment-3d",
      "module-vfx-ultra"
    ]
  },
  "sharedFileCache": "ds-store-assets-v1",
  "incrementalUpdate": true,
  "memoryManager": "demo/cache-memory-manager.js",
  "qualityModeAliases": {
    "economy": "basic",
    "balanced": "intermediate",
    "high": "advanced",
    "ultraAdvanced": "realism"
  }
}