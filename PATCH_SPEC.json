{
  "name": "AGV Sub Student Workspace Patch",
  "version": "0.1.41",
  "scope": "programacao-front-end-sub FE01-FE07",
  "layout": {
    "desktop": "reference-left-editor-right",
    "mobile": "reference-above-editor-below"
  },
  "reference": {
    "source": "exercise_reference_files",
    "readonly": true,
    "copyBlocked": true,
    "lineNumbers": true,
    "syntaxHighlight": true,
    "visualTheme": "VS Code dark"
  },
  "studentDownloads": {
    "source": "student_files",
    "individual": true,
    "zip": true,
    "allowedBeforeCompletion": true,
    "referenceExcluded": true,
    "saveBeforeDownload": true
  },
  "delivery": {
    "github": "student_delivery_settings.repository_url",
    "classroom": "classroom_links.url"
  },
  "security": {
    "serviceRoleInFrontend": false,
    "usesExistingAuthenticatedSession": true
  }
}
