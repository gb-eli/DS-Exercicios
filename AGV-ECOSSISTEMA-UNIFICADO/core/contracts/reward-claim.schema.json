{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGV Core Reward Claim",
  "type": "object",
  "required": [
    "platformId",
    "eventType",
    "idempotencyKey"
  ],
  "properties": {
    "platformId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "activityId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "eventType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "evidenceId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "attemptId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "metadata": {
      "type": "object"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    }
  },
  "not": {
    "required": [
      "amount"
    ]
  },
  "additionalProperties": false
}