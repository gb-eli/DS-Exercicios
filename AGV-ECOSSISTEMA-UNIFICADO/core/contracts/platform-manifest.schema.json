{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGV Platform Manifest",
  "type": "object",
  "required": [
    "platformId",
    "name",
    "version",
    "integrationVersion",
    "capabilities"
  ],
  "properties": {
    "platformId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "integrationVersion": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "progress": {
          "type": "boolean"
        },
        "xp": {
          "type": "boolean"
        },
        "points": {
          "type": "boolean"
        },
        "wallet": {
          "type": "boolean"
        },
        "store": {
          "type": "boolean"
        },
        "inventory": {
          "type": "boolean"
        },
        "marketplace": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "activityNamespace": {
      "type": "string"
    },
    "legacyStoragePrefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}