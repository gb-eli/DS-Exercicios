do $$ declare p uuid; begin
select id into p from public.platforms where code='lab-virtual';
if p is null then raise exception 'platform lab-virtual missing'; end if;
insert into public.activity_catalog(platform_id,activity_id,name,reward_policy,max_xp,max_points,max_coins,repeatable,active,metadata) values
(p,'tool:data-tools','Bits, Bases e Codificações','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"data-tools","level":"basic","module":"data-tools-lab","type":"lab","firstValidationBonus":15}'::jsonb),
(p,'tool:git-github','Git e GitHub','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"git-github","level":"intermediate","module":"git-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:cybersecurity','Cibersegurança Defensiva','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"cybersecurity","level":"advanced","module":"security-lab","type":"lab","firstValidationBonus":50}'::jsonb),
