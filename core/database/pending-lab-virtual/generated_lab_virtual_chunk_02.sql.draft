(p,'tool:automation-iot','Automação, IoT, OCR e Robótica','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"automation-iot","level":"advanced","module":"automation-lab","type":"lab","firstValidationBonus":50}'::jsonb),
