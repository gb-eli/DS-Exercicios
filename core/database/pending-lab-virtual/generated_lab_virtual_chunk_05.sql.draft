do $$ declare p uuid; begin
select id into p from public.platforms where code='lab-virtual';
if p is null then raise exception 'platform lab-virtual missing'; end if;
insert into public.activity_catalog(platform_id,activity_id,name,reward_policy,max_xp,max_points,max_coins,repeatable,active,metadata) values
(p,'completion:audio:classification:140','audio:classification:140','rule_validated',25,0,10,false,true,'{"kind":"completion","completionId":"audio:classification:140","toolId":"audio-lab","category":"audio","minSeconds":2}'::jsonb),
(p,'completion:audio:classification:440','audio:classification:440','rule_validated',25,0,10,false,true,'{"kind":"completion","completionId":"audio:classification:440","toolId":"audio-lab","category":"audio","minSeconds":2}'::jsonb),
