(p,'completion:tutorial:cloud-intro','tutorial:cloud-intro','rule_validated',35,0,15,false,true,'{"kind":"completion","completionId":"tutorial:cloud-intro","toolId":"tutorial-center","category":"tutorial","minSeconds":8}'::jsonb),
