do $$ declare p uuid; begin
select id into p from public.platforms where code='lab-virtual';
if p is null then raise exception 'platform lab-virtual missing'; end if;
insert into public.activity_catalog(platform_id,activity_id,name,reward_policy,max_xp,max_points,max_coins,repeatable,active,metadata) values
(p,'completion:device:first-photo','device:first-photo','rule_validated',25,0,10,false,true,'{"kind":"completion","completionId":"device:first-photo","toolId":"device-sensors","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:device:location-permission','device:location-permission','rule_validated',20,0,5,false,true,'{"kind":"completion","completionId":"device:location-permission","toolId":"device-sensors","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:graphics:first-valid-export','graphics:first-valid-export','rule_validated',35,0,12,false,true,'{"kind":"completion","completionId":"graphics:first-valid-export","toolId":"graphics","category":"explicit","minSeconds":4}'::jsonb),
