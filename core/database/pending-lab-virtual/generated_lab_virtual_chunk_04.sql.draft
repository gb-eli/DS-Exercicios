(p,'completion:traffic:radar-precision','traffic:radar-precision','rule_validated',45,0,15,false,true,'{"kind":"completion","completionId":"traffic:radar-precision","toolId":"traffic-radar","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:traffic:signal-safe','traffic:signal-safe','rule_validated',70,0,25,false,true,'{"kind":"completion","completionId":"traffic:signal-safe","toolId":"traffic-radar","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:thermal-panel:limits','thermal-panel:limits','rule_validated',70,0,30,false,true,'{"kind":"completion","completionId":"thermal-panel:limits","toolId":"thermal-panel","category":"explicit","minSeconds":4}'::jsonb),
