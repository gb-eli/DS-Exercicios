(p,'completion:productivity:mail-cco','productivity:mail-cco','rule_validated',55,0,20,false,true,'{"kind":"completion","completionId":"productivity:mail-cco","toolId":"productivity-suite","category":"explicit","minSeconds":4}'::jsonb),
