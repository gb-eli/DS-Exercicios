on conflict(platform_id,activity_id) do update set name=excluded.name,reward_policy=excluded.reward_policy,max_xp=excluded.max_xp,max_points=excluded.max_points,max_coins=excluded.max_coins,repeatable=excluded.repeatable,active=true,metadata=excluded.metadata;
delete from public.reward_rules where platform_id=p and activity_id in ('completion:device:first-photo','completion:device:location-permission','completion:graphics:first-valid-export','completion:productivity:sheet-formulas','completion:productivity:document','completion:productivity:slides','completion:productivity:presentation-view','completion:productivity:form','completion:productivity:phishing','completion:productivity:mail-cco','completion:productivity:mail-flow','completion:printing3d:successful-print-v40','completion:traffic:radar-precision','completion:traffic:signal-safe','completion:thermal-panel:limits','completion:tech-explorer:research-started','completion:biomonitor:comparison','completion:audio:classification:80');
