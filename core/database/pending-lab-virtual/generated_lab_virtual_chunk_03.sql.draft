do $$ declare p uuid; begin
select id into p from public.platforms where code='lab-virtual';
if p is null then raise exception 'platform lab-virtual missing'; end if;
insert into public.activity_catalog(platform_id,activity_id,name,reward_policy,max_xp,max_points,max_coins,repeatable,active,metadata) values
(p,'tool:energy-systems','Energia, Queda de Tensão, Solar e Eólica','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"energy-systems","level":"intermediate","module":"energy-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:traffic-radar','Radar, Semáforo e Trânsito Inteligente','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"traffic-radar","level":"intermediate","module":"traffic-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:world-tools','Relógios Mundiais, Alarmes e Conversores','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"world-tools","level":"basic","module":"world-tools-lab","type":"lab","firstValidationBonus":15}'::jsonb),
(p,'tool:solar-system','Sistema Solar Interativo 2D e Perspectiva','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"solar-system","level":"intermediate","module":"solar-system-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:school-randomizer','Sorteios, Turmas e Organização Escolar','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"school-randomizer","level":"basic","module":"school-randomizer-lab","type":"lab","firstValidationBonus":15}'::jsonb),
(p,'tool:biomonitor','BioMonitor — Batimentos e Sinais','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"biomonitor","level":"intermediate","module":"biomonitor-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:thermal-panel','Clima Extremo — Temperatura e Sensores','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"thermal-panel","level":"intermediate","module":"thermal-panel-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:audio-lab','AudioLab — Frequências e Equalização','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"audio-lab","level":"intermediate","module":"audio-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:iptv-streaming','IPTV, Streaming e Qualidade de Rede','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"iptv-streaming","level":"intermediate","module":"iptv-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:device-sensors','Câmera, Microfone e Sensores do Dispositivo','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"device-sensors","level":"intermediate","module":"device-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'tool:artificial-intelligence','Inteligência Artificial e Redes Neurais','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"artificial-intelligence","level":"advanced","module":"ai-lab","type":"lab","firstValidationBonus":50}'::jsonb),
(p,'tool:network-operations','Rack, MikroTik, CFTV e Cabeamento','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"network-operations","level":"advanced","module":"network-ops-lab","type":"lab","firstValidationBonus":50}'::jsonb),
(p,'tool:game-engine','Laboratório de Engine e Renderização','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"game-engine","level":"advanced","module":"game-engine-lab","type":"lab","firstValidationBonus":50}'::jsonb),
(p,'tool:electronics','Eletrônica, Energia e Calculadoras','no_economic_reward',0,0,0,false,true,'{"kind":"tool","toolId":"electronics","level":"intermediate","module":"electronics-lab","type":"lab","firstValidationBonus":30}'::jsonb),
(p,'completion:solar:rocket-launch','solar:rocket-launch','rule_validated',110,0,58,false,true,'{"kind":"completion","completionId":"solar:rocket-launch","toolId":"solar-system","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:iptv:stable','iptv:stable','rule_validated',60,0,25,false,true,'{"kind":"completion","completionId":"iptv:stable","toolId":"iptv-streaming","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:blocks:visual-flow-v2','blocks:visual-flow-v2','rule_validated',35,0,22,false,true,'{"kind":"completion","completionId":"blocks:visual-flow-v2","toolId":"block-programming","category":"explicit","minSeconds":4}'::jsonb),
(p,'completion:market:three-positions','market:three-positions','rule_validated',45,0,0,false,true,'{"kind":"completion","completionId":"market:three-positions","toolId":"market-simulator","category":"explicit","minSeconds":4}'::jsonb)
on conflict(platform_id,activity_id) do update set name=excluded.name,reward_policy=excluded.reward_policy,max_xp=excluded.max_xp,max_points=excluded.max_points,max_coins=excluded.max_coins,repeatable=excluded.repeatable,active=true,metadata=excluded.metadata;
delete from public.reward_rules where platform_id=p and activity_id in ('tool:energy-systems','tool:traffic-radar','tool:world-tools','tool:solar-system','tool:school-randomizer','tool:biomonitor','tool:thermal-panel','tool:audio-lab','tool:iptv-streaming','tool:device-sensors','tool:artificial-intelligence','tool:network-operations','tool:game-engine','tool:electronics','completion:solar:rocket-launch','completion:iptv:stable','completion:blocks:visual-flow-v2','completion:market:three-positions');
insert into public.reward_rules(platform_id,activity_id,event_type,trust_level,xp,points,coins,repeatable,active,metadata) values
