import "jsr:@supabase/functions-js/edge-runtime.d.ts";
import { createClient } from "jsr:@supabase/supabase-js@2.111.0";

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};
const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), {
  status,
  headers: { ...CORS, "Content-Type": "application/json" },
});
const s = (v: unknown, n = 500) => String(v ?? "").trim().slice(0, n);
const boolOrNull = (obj: Record<string, unknown>, key: string) =>
  Object.prototype.hasOwnProperty.call(obj, key) ? (obj[key] == null ? null : !!obj[key]) : undefined;
const isoOrNull = (v: unknown) => {
  if (v == null || String(v).trim() === "") return null;
  const d = new Date(String(v));
  if (!Number.isFinite(d.getTime())) throw new Error("invalid_datetime");
  return d.toISOString();
};

type Ctx = {
  user: { id: string; email?: string | null };
  role: string;
  admin: boolean;
  assigned: string[];
  db: ReturnType<typeof createClient>;
};

async function context(req: Request): Promise<Ctx | Response> {
  const url = Deno.env.get("SUPABASE_URL")!;
  const ah = req.headers.get("Authorization") || "";
  const userClient = createClient(url, Deno.env.get("SUPABASE_ANON_KEY")!, { global: { headers: { Authorization: ah } } });
  const db = createClient(url, Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!, { auth: { persistSession: false, autoRefreshToken: false } });
  const { data: { user }, error } = await userClient.auth.getUser();
  if (error || !user?.email) return json({ error: "unauthorized" }, 401);
  const [{ data: profile }, { data: allow }] = await Promise.all([
    db.from("profiles").select("role,active").eq("id", user.id).maybeSingle(),
    db.from("staff_allowlist").select("role,active").eq("email", user.email.toLowerCase()).eq("active", true).maybeSingle(),
  ]);
  const role = String(allow?.role || profile?.role || "");
  if (profile?.active === false || !["teacher", "admin", "super_admin"].includes(role)) return json({ error: "forbidden" }, 403);
  const admin = role === "admin" || role === "super_admin";
  let assigned: string[] = [];
  if (!admin) {
    const { data } = await db.from("teacher_classes").select("class_id").eq("teacher_email", user.email.toLowerCase()).eq("active", true);
    assigned = (data || []).map((x: any) => String(x.class_id));
  }
  return { user: { id: user.id, email: user.email }, role, admin, assigned, db };
}

async function assertClass(ctx: Ctx, classId: string) {
  if (!classId) throw new Error("class_required");
  if (!ctx.admin && !ctx.assigned.includes(classId)) throw new Error("class_out_of_scope");
  const { data } = await ctx.db.from("classes").select("id,active").eq("id", classId).eq("active", true).maybeSingle();
  if (!data) throw new Error("class_not_found");
}

async function assertExerciseBelongs(ctx: Ctx, exerciseId: string, classId: string) {
  const { data: ex } = await ctx.db.from("exercises").select("id,class_id,subject_id,active").eq("id", exerciseId).eq("active", true).maybeSingle();
  if (!ex) throw new Error("exercise_not_found");
  if (ex.class_id) {
    if (String(ex.class_id) !== classId) throw new Error("exercise_out_of_class");
    return;
  }
  if (!ex.subject_id) throw new Error("exercise_without_scope");
  const { data: cs } = await ctx.db.from("class_subjects").select("class_id").eq("class_id", classId).eq("subject_id", ex.subject_id).eq("active", true).maybeSingle();
  if (!cs) throw new Error("exercise_out_of_class");
}

async function assertStudentInClass(ctx: Ctx, studentId: string, classId: string) {
  const { data: p } = await ctx.db.from("profiles").select("id,role,active").eq("id", studentId).eq("role", "student").maybeSingle();
  if (!p) throw new Error("student_not_activated");
  const { data: m } = await ctx.db.from("class_memberships").select("class_id").eq("user_id", studentId).eq("class_id", classId).eq("active", true).maybeSingle();
  if (!m) throw new Error("student_out_of_class");
}

function releasePatch(body: Record<string, unknown>, actorId: string) {
  const releaseAt = isoOrNull(body.release_at);
  const lockAt = isoOrNull(body.lock_at);
  if (releaseAt && lockAt && Date.parse(lockAt) <= Date.parse(releaseAt)) throw new Error("lock_must_be_after_release");
  const patch: Record<string, unknown> = {
    enabled: body.enabled !== false,
    release_at: releaseAt,
    lock_at: lockAt,
    created_by: actorId,
    updated_at: new Date().toISOString(),
  };
  for (const key of ["allow_html_base", "allow_css_base", "allow_js_base", "allow_extra_hints", "allow_guided_support"]) {
    const v = boolOrNull(body, key);
    if (v !== undefined) patch[key] = v;
  }
  return patch;
}

async function upsertClass(ctx: Ctx, body: Record<string, unknown>) {
  const classId = s(body.class_id, 80), exerciseId = s(body.exercise_id, 80);
  await assertClass(ctx, classId);
  await assertExerciseBelongs(ctx, exerciseId, classId);
  const patch = { exercise_id: exerciseId, class_id: classId, student_id: null, ...releasePatch(body, ctx.user.id) };
  const { data: old } = await ctx.db.from("exercise_releases").select("id").eq("exercise_id", exerciseId).eq("class_id", classId).is("student_id", null).order("updated_at", { ascending: false }).limit(1).maybeSingle();
  const q = old?.id
    ? await ctx.db.from("exercise_releases").update(patch).eq("id", old.id).select().single()
    : await ctx.db.from("exercise_releases").insert(patch).select().single();
  if (q.error) throw q.error;
  await ctx.db.from("admin_audit_log").insert({ actor_user_id: ctx.user.id, action: "exercise_class_release_saved", payload: { class_id: classId, exercise_id: exerciseId, enabled: patch.enabled, release_at: patch.release_at, lock_at: patch.lock_at } });
  return q.data;
}

async function upsertStudent(ctx: Ctx, body: Record<string, unknown>, studentId: string) {
  const classId = s(body.class_id, 80), exerciseId = s(body.exercise_id, 80);
  await assertClass(ctx, classId);
  await assertExerciseBelongs(ctx, exerciseId, classId);
  await assertStudentInClass(ctx, studentId, classId);
  const patch = { exercise_id: exerciseId, class_id: null, student_id: studentId, ...releasePatch(body, ctx.user.id) };
  const { data: old } = await ctx.db.from("exercise_releases").select("id").eq("exercise_id", exerciseId).eq("student_id", studentId).order("updated_at", { ascending: false }).limit(1).maybeSingle();
  const q = old?.id
    ? await ctx.db.from("exercise_releases").update(patch).eq("id", old.id).select().single()
    : await ctx.db.from("exercise_releases").insert(patch).select().single();
  if (q.error) throw q.error;
  await ctx.db.from("admin_audit_log").insert({ actor_user_id: ctx.user.id, action: "exercise_student_release_saved", target_user_id: studentId, payload: { class_id: classId, exercise_id: exerciseId, enabled: patch.enabled, release_at: patch.release_at, lock_at: patch.lock_at } });
  return q.data;
}

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: CORS });
  try {
    const c = await context(req);
    if (c instanceof Response) return c;
    const body = await req.json().catch(() => ({})) as Record<string, unknown>;
    const action = s(body.action, 50);

    if (action === "list") {
      if (c.admin) {
        const { data, error } = await c.db.from("exercise_releases").select("*").order("updated_at", { ascending: false });
        if (error) throw error;
        return json({ ok: true, releases: data || [], scope: "global" });
      }
      const { data: classRows } = c.assigned.length
        ? await c.db.from("exercise_releases").select("*").in("class_id", c.assigned)
        : { data: [] as any[] };
      const { data: memberships } = c.assigned.length
        ? await c.db.from("class_memberships").select("user_id").in("class_id", c.assigned).eq("active", true)
        : { data: [] as any[] };
      const ids = [...new Set((memberships || []).map((x: any) => String(x.user_id)))];
      const { data: studentRows } = ids.length
        ? await c.db.from("exercise_releases").select("*").in("student_id", ids)
        : { data: [] as any[] };
      return json({ ok: true, releases: [...(classRows || []), ...(studentRows || [])], scope: "assigned", assigned_class_ids: c.assigned });
    }

    if (action === "save_class") return json({ ok: true, release: await upsertClass(c, body) });
    if (action === "save_student") {
      const studentId = s(body.student_id, 80);
      if (!studentId) return json({ error: "student_required" }, 400);
      return json({ ok: true, release: await upsertStudent(c, body, studentId) });
    }
    if (action === "save_group") {
      const ids = Array.isArray(body.student_ids) ? [...new Set(body.student_ids.map(x => s(x, 80)).filter(Boolean))].slice(0, 60) : [];
      if (!ids.length) return json({ error: "student_ids_required" }, 400);
      const applied: string[] = [], skipped: { student_id: string; reason: string }[] = [];
      for (const id of ids) {
        try { await upsertStudent(c, body, id); applied.push(id); }
        catch (e) { skipped.push({ student_id: id, reason: String((e as any)?.message || e) }); }
      }
      await c.db.from("admin_audit_log").insert({ actor_user_id: c.user.id, action: "exercise_group_release_saved", payload: { class_id: s(body.class_id,80), exercise_id: s(body.exercise_id,80), applied_count: applied.length, skipped_count: skipped.length } });
      return json({ ok: true, applied, skipped });
    }
    if (action === "bulk_class") {
      const classId = s(body.class_id, 80);
      await assertClass(c, classId);
      const ids = Array.isArray(body.exercise_ids) ? [...new Set(body.exercise_ids.map(x => s(x,80)).filter(Boolean))].slice(0, 150) : [];
      if (!ids.length) return json({ error: "exercise_ids_required" }, 400);
      const applied: string[] = [], skipped: { exercise_id: string; reason: string }[] = [];
      for (const exerciseId of ids) {
        try { await upsertClass(c, { ...body, exercise_id: exerciseId, class_id: classId }); applied.push(exerciseId); }
        catch (e) { skipped.push({ exercise_id: exerciseId, reason: String((e as any)?.message || e) }); }
      }
      return json({ ok: true, applied, skipped });
    }
    if (action === "clear_student_override") {
      const studentId = s(body.student_id,80), exerciseId = s(body.exercise_id,80), classId = s(body.class_id,80);
      await assertClass(c, classId); await assertExerciseBelongs(c, exerciseId, classId); await assertStudentInClass(c, studentId, classId);
      const { data, error } = await c.db.from("exercise_releases").delete().eq("student_id",studentId).eq("exercise_id",exerciseId).select("id");
      if (error) throw error;
      await c.db.from("admin_audit_log").insert({ actor_user_id:c.user.id, action:"exercise_student_release_cleared", target_user_id:studentId, payload:{class_id:classId,exercise_id:exerciseId,count:(data||[]).length} });
      return json({ ok:true, removed:(data||[]).length });
    }
    return json({ error: "unknown_action" }, 400);
  } catch (e) {
    const m = String((e as any)?.message || e);
    const status = /out_of_scope|out_of_class|forbidden/.test(m) ? 403 : /not_found/.test(m) ? 404 : /required|invalid|must_be/.test(m) ? 400 : 500;
    return json({ error: m }, status);
  }
});
