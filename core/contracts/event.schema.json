{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGV Core Event",
  "type": "object",
  "required": [
    "eventId",
    "idempotencyKey",
    "platformId",
    "eventType",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "platformId": {
      "type": "string"
    },
    "activityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "eventType": {
      "enum": [
        "session.started",
        "session.ended",
        "activity.started",
        "activity.progress",
        "activity.completed",
        "evidence.submitted",
        "reward.claimed"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}